# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── VLESS fallback / built-in speedtest ──
# Applies to VLESS + TCP nodes; non-VLESS traffic is forwarded to a built-in
# speedtest site over a Unix domain socket. Set enabled: false to opt out.
# kernel:
#   fallback:
#     enabled: true
#     title: "Speed Test"
#     max_transfer_mb: 256
#     max_concurrent: 32

# ── Multiple instances ──
# xray is the only supported kernel; kernel.type is deprecated and ignored.
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only
